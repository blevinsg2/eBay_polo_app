# Copy to .env, edit, then load it before starting:  set -a; . ./.env; set +a; python3 app/server.py
# Every value here is a placeholder. Nothing in this project needs an API key:
# OCR runs offline, maps use public OSM/OSRM, and the bots that complete jobs live outside this repo.

# Where the local server listens
POLO_HOST=127.0.0.1
POLO_PORT=8765

# Jobs, uploads, receipts and ratings live here (gitignored). Default: ./var
POLO_DATA_DIR=./var

# 1 = copy the EXAMPLE fixtures into an empty data dir on start (same as --demo)
POLO_DEMO=0

# Your home / usual start point. No default on purpose; leave blank to use the EXAMPLE start.
POLO_HOME_LABEL=
POLO_HOME_LAT=
POLO_HOME_LNG=

# Your own pit-stop list (same shape as config/pitstops.example.json)
POLO_PITSTOPS_FILE=./config/pitstops.example.json

# Nominatim asks for an identifying User-Agent. Use your app name + a way to reach you.
POLO_NOMINATIM_UA=polo-pipeline/1.0 (your-contact-here)
POLO_NOMINATIM_BASE=https://nominatim.openstreetmap.org
POLO_OSRM_BASE=https://router.project-osrm.org

# app/complete_handoff.py posts results here
POLO_URL=http://127.0.0.1:8765

# tools/photos/listing_photo.py
POLO_FONT=
HANGER_TOL=12
HANGER_GRAY=1

# tools/listings/fetch_listing_photos.sh
POLO_FETCH_DIR=listing_photos
POLO_FETCH_UA=

# If you wire up a real comps source (e.g. the eBay Browse API), keep its keys here, never in code:
# EBAY_CLIENT_ID=your-ebay-client-id
# EBAY_CLIENT_SECRET=your-ebay-client-secret
